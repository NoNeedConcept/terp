<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Foundation helpers for .NET apps: host setups, startup gates, diagnostics, resilience, network and date helpers.</Description>
        <PackageTags>terp;helpers;hosting;setup;startup;diagnostics;resilience</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Options" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Terp.Tests" />
    </ItemGroup>

    <Target Name="TerpLogo" BeforeTargets="Build" Condition="'$(ContinuousIntegrationBuild)' != 'true'">
        <Message Text=" " Importance="high"/>
        <Message Text="                  /\" Importance="high"/>
        <Message Text="                 /  \" Importance="high"/>
        <Message Text="                /____\" Importance="high"/>
        <Message Text="                | [] |" Importance="high"/>
        <Message Text="           _.-'`------`'-._" Importance="high"/>
        <Message Text="        .-'                '-." Importance="high"/>
        <Message Text="     .-'                      '-." Importance="high"/>
        <Message Text="~~~/______________________________\~~~" Importance="high"/>
        <Message Text="                 terp" Importance="high"/>
        <Message Text=" " Importance="high"/>
    </Target>

</Project>
